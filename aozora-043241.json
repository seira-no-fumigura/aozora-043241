   "form": "prose"
  },
  {
   "id": "aozora-043241-000037",
   "pid": "",
   "pages": [],
   "no": 37,
   "vol": "",
   "kotobagaki": "",
   "author": "",
   "text": "二月三日、立春",
   "sachu": "",
   "poems": [],
   "notes": [],
   "lb": [],
   "form": "prose"
  },
  {
   "id": "aozora-043241-000038",
   "pid": "",
   "pages": [],
   "no": 38,
   "vol": "",
   "kotobagaki": "",
   "author": "",
   "text": "消ぬが上に、み雪ふるなり、山里の、いづこの空に春は来ぬらん。",
   "sachu": "",
   "poems": [],
   "notes": [],
   "lb": [],
   "form": "prose"
  },
  {
   "id": "aozora-043241-000039",
   "pid": "",
   "pages": [],
   "no": 39,
   "vol": "",
   "kotobagaki": "",
   "author": "",
