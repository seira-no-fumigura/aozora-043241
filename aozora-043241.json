  },
  {
   "id": "aozora-043241-000031",
   "pid": "",
   "pages": [],
   "no": 31,
   "vol": "",
   "kotobagaki": "",
   "author": "",
   "text": "明治三十一年元旦",
   "sachu": "",
   "poems": [],
   "notes": [],
   "lb": [],
   "form": "prose"
  },
  {
   "id": "aozora-043241-000032",
   "pid": "",
   "pages": [],
   "no": 32,
   "vol": "",
   "kotobagaki": "",
   "author": "",
   "text": "あら玉の、年返りぬと聞くからに、古る事さへぞ思ひ出でぬる。",
   "sachu": "",
   "poems": [],
   "notes": [],
   "lb": [],
   "form": "prose"
  },
  {
